{
  "720p-francais": {
    "format": "bv*[height<=720][lang=fr]/bv*[height<=720]+ba[lang=fr]/bv*[height<=720]+ba/b",
    "formatsort": ["res:720", "lang:fr", "codec:h264", "ext:mp4"],
    "merge_output_format": "mp4",
    "writesubtitles": true,
    "writeautomaticsub": true,
    "subtitleslangs": ["fr", "en"],
    "postprocessors": [
      {"key": "FFmpegMetadata", "add_metadata": true, "add_chapters": true},
      {"key": "EmbedThumbnail"},
      {"key": "FFmpegEmbedSubtitle", "already_have_subtitle": false}
    ]
  },
  "1080p-francais": {
